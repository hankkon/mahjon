{
  "name": "taiwan-mahjong1",
  "version": "1.0.0",
  "private": true,
  "description": "Taiwan 16-tile Mahjong — Godot 4.7 client + Node.js/TypeScript authoritative server (pnpm monorepo)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @taiwan-mahjong/server dev",
    "dev:web": "pnpm --filter @taiwan-mahjong/server dev:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
